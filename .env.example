# AI provider for bookmark categorization.
# The app auto-detects the first configured provider (cheapest first).
# Or set EXPO_PUBLIC_AI_PROVIDER to force a specific one.

# --- Recommended: Groq (free tier, very fast, small Llama model) ---
# Get a key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=gsk_your-key-here

# --- Google Gemini (cheapest paid option, ~$0.075/1M tokens) ---
# Get a key at https://aistudio.google.com/apikey
# EXPO_PUBLIC_GEMINI_API_KEY=your-key-here

# --- OpenRouter (access many models, including free ones) ---
# Get a key at https://openrouter.ai/keys
# EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-your-key-here

# --- OpenAI (reliable, slightly more expensive) ---
# Get a key at https://platform.openai.com/api-keys
# EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Optional: force a specific provider (groq | gemini | openrouter | openai)
# EXPO_PUBLIC_AI_PROVIDER=groq

# Optional: override the default model for the chosen provider
# EXPO_PUBLIC_AI_MODEL=llama-3.1-8b-instant
